# Python environments and generated metadata
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage

# Telescope payloads and local extraction products
data/
data_*/
*.fil
*.h5
*.raw

# Detector-v0.6 ships five small, frozen scramble tables as package data.
# Keep telescope/extraction data ignored while allowing only this exact
# implementation-resource subtree to be versioned and reproduced from clone.
!src/seti_repeater/data/
!src/seti_repeater/data/m37_scrambles/
!src/seti_repeater/data/m37_scrambles/*.bin

# Reproducibility work directories and local release archives
results_*_repeat/
SETI_Repeater_Pipeline_Milestone_*.zip

# M41 execution receipts, the reassembled ledger, and restart checkpoints are
# local working data. The compact aggregate and ledger transport parts remain
# publishable.
results_m41_m37_high_snr_truth_local_calibration/trials/
results_m41_m37_high_snr_truth_local_calibration/trial-ledger.jsonl.gz
m41_operational_checkpoints/

# Editor and operating-system files
.DS_Store
*.swp

# LS4F ephemeral raw spectra
data_ls4f_runtime/
