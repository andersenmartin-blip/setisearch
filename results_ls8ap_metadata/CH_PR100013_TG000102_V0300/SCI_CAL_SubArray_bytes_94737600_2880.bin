XTENSION= 'BINTABLE'           / binary table extension                         BITPIX  =                    8 / 8-bit bytes                                    NAXIS   =                    2 / 2-dimensional binary table                     NAXIS1  =                  161 / width of table in bytes                        NAXIS2  =                  296 / number of rows in table                        PCOUNT  =                    0 / size of special data area                      GCOUNT  =                    1 / one data group (required keyword)              TFIELDS =                   29 / number of fields in each row                   TTYPE1  = 'UTC_TIME'           / UTC time, middle of the measurements           TFORM1  = '26A     '           / format of field                                TUNIT1  = 'TIMESYS=UTC'        / Unit of column UTC_TIME                        TTYPE2  = 'MJD_TIME'           / Modified Julian Day, middle of the measurementsTFORM2  = '1D      '           / format of field                                TUNIT2  = 'day     '           / Unit of column MJD_TIME                        TTYPE3  = 'BJD_TIME'           / barycentric date, middle of measurements       TFORM3  = '1D      '           / format of field                                TUNIT3  = 'day     '           / Unit of column BJD_TIME                        TTYPE4  = 'LOS_TO_SUN_ANGLE'   / Angle between line-of-sight and Sun            TFORM4  = '1D      '           / format of field                                TUNIT4  = 'deg     '           / Unit of column LOS_TO_SUN_ANGLE                TTYPE5  = 'LOS_TO_MOON_ANGLE'  / Angle between line-of-sight and Moon           TFORM5  = '1D      '           / format of field                                TUNIT5  = 'deg     '           / Unit of column LOS_TO_MOON_ANGLE               TTYPE6  = 'LOS_TO_EARTH_ANGLE' / Angle between line-of-sight and Earth limb     TFORM6  = '1D      '           / format of field                                TUNIT6  = 'deg     '           / Unit of column LOS_TO_EARTH_ANGLE              TTYPE7  = 'LATITUDE'           / Geodetic latitude of the spacecraft            TFORM7  = '1E      '           / format of field                                TUNIT7  = 'deg     '           / Unit of column LATITUDE                        TTYPE8  = 'LONGITUDE'          / Geodetic longitude of the spacecraft           TFORM8  = '1E      '           / format of field                                TUNIT8  = 'deg     '           / Unit of column LONGITUDE                       TTYPE9  = 'CE_COUNTER'         / image counter per visit                        TFORM9  = '1I      '           / format of field                                TZERO9  =                32768 / offset for unsigned integers                   TSCAL9  =                    1 / data are not scaled                            