      "purpose": "Original float64 cumulative-sum origin is first z/s.power frame cell",
      "numbered_lines": [
        {
          "line": 152,
          "text": "def _box_arrays(z: np.ndarray, mask: np.ndarray, cfg: Config) -> dict:"
        },
        {
          "line": 153,
          "text": "    # Prefix sums form four cached row-box arrays. Search needs one score"
        },
        {
          "line": 154,
          "text": "    # gather and one validity gather per row, rather than two prefix pairs."
        },
        {
          "line": 155,
          "text": "    prefix = np.zeros((z.shape[0], z.shape[1] + 1), dtype=np.float64)"
        },
        {
          "line": 156,
          "text": "    prefix[:, 1:] = np.cumsum(z, axis=1, dtype=np.float64)"
        },
        {
          "line": 157,
          "text": "    bad = np.zeros(prefix.shape, dtype=np.int32)"
        },
        {
          "line": 158,
          "text": "    bad[:, 1:] = np.cumsum(~mask, axis=1, dtype=np.int32)"
        },
        {
          "line": 159,
          "text": "    return {width: (prefix[:, width:] - prefix[:, :-width],"
        },
        {
          "line": 160,
          "text": "                    (bad[:, width:] - bad[:, :-width]) == 0) for width in cfg.widths}"
        }
      ]
    },
