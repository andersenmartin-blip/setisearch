      "purpose": "Whole-frame float64 preprocessing, core4096 metadata domain,501 median filter, location/MAD and z equation",
      "numbered_lines": [
        {
          "line": 111,
          "text": "def preprocess(s: Scan, cfg: Config) -> tuple[np.ndarray, np.ndarray, dict]:"
        },
        {
          "line": 112,
          "text": "    \"\"\"Normalize on frozen static source channels, not data-selected regions.\"\"\""
        },
        {
          "line": 113,
          "text": "    p = np.asarray(s.power, dtype=np.float64)"
        },
        {
          "line": 114,
          "text": "    if not np.isfinite(p).all() or np.any(p < 0):"
        },
        {
          "line": 115,
          "text": "        raise ValueError(f\"{s.scan_id}: non-finite/missing or negative power is an input error\")"
        },
        {
          "line": 116,
          "text": "    m = _input_mask(s)"
        },
        {
          "line": 117,
          "text": "    source = np.asarray(s.normalization_source_channels, dtype=np.int64)"
        },
        {
          "line": 118,
          "text": "    if (source.ndim != 1 or len(source) != cfg.carrier_count or"
        },
        {
          "line": 119,
          "text": "            len(np.unique(source)) != len(source)):"
        },
        {
          "line": 120,
          "text": "        raise ValueError(f\"{s.scan_id}: unique frozen normalization core required\")"
        },
        {
          "line": 121,
          "text": "    local = source - s.source_channel0"
        },
        {
          "line": 122,
          "text": "    margin = cfg.running_median_channels//2"
        },
        {
          "line": 123,
          "text": "    if local.min() < margin or local.max() >= p.shape[1] - margin:"
        },
        {
          "line": 124,
          "text": "        raise ValueError(f\"{s.scan_id}: normalization core lacks filtering margin\")"
        },
        {
          "line": 125,
          "text": "    core = np.where(m[:, local], p[:, local], np.nan)"
        },
        {
          "line": 126,
          "text": "    core_count = m[:, local].sum(axis=1)"
        },
        {
          "line": 127,
          "text": "    if np.any(core_count == 0):"
        },
        {
          "line": 128,
          "text": "        raise ValueError(f\"{s.scan_id}: entirely masked normalization row\")"
        },
        {
          "line": 129,
          "text": "    row_level = np.nanmedian(core, axis=1)"
        },
        {
          "line": 130,
          "text": "    if np.any(row_level <= 0) or not np.isfinite(row_level).all():"
        },
        {
          "line": 131,
          "text": "        raise ValueError(f\"{s.scan_id}: invalid row power median\")"
        },
        {
          "line": 132,
          "text": "    normalized = p / row_level[:, None]"
        },
        {
          "line": 133,
          "text": "    residual = normalized - median_filter(normalized, size=(1, cfg.running_median_channels),"
        },
        {
          "line": 134,
          "text": "                                           mode=\"nearest\")"
        },
        {
          "line": 135,
          "text": "    center = np.nanmedian(np.where(m[:, local], residual[:, local], np.nan), axis=1)"
        },
        {
          "line": 136,
          "text": "    scale = 1.4826 * np.nanmedian(np.where(m[:, local],"
        },
        {
          "line": 137,
          "text": "                       np.abs(residual[:, local] - center[:, None]), np.nan), axis=1)"
        },
        {
          "line": 138,
          "text": "    if np.any(scale <= 0) or not np.isfinite(scale).all():"
        },
        {
          "line": 139,
          "text": "        raise ValueError(f\"{s.scan_id}: invalid empirical residual MAD\")"
        },
        {
          "line": 140,
          "text": "    centered_core = residual[:, local] - center[:, None]"
        },
        {
          "line": 141,
          "text": "    winsorized = np.clip(centered_core, -5*scale[:, None], 5*scale[:, None])"
        },
        {
          "line": 142,
          "text": "    location = center + np.nanmean(np.where(m[:, local], winsorized, np.nan), axis=1)"
        },
        {
          "line": 143,
          "text": "    z = (residual - location[:, None]) / scale[:, None]"
        },
        {
          "line": 144,
          "text": "    return z, m, {\"row_power_median\": row_level.tolist(),"
        },
        {
          "line": 145,
          "text": "                  \"row_residual_median\": center.tolist(),"
        },
        {
          "line": 146,
          "text": "                  \"row_winsorized_residual_location\": location.tolist(),"
        },
        {
          "line": 147,
          "text": "                  \"row_residual_MAD_scale\": scale.tolist(),"
        },
        {
          "line": 148,
          "text": "                  \"normalization_unmasked_counts\": core_count.tolist(),"
        },
        {
          "line": 149,
          "text": "                  \"normalization_source_channels\": source.tolist()}"
        },
        {
          "line": 150,
          "text": ""
        }
