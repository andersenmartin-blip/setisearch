<INFO name="QUERY" value="SELECT o.dp_id, o.obs_publisher_did, o.obs_id, o.target_name, o.s_ra, o.s_dec, o.instrument_name, o.obs_collection, o.dataproduct_type, o.t_min, o.t_max, o.t_exptime, o.em_min, o.em_max, o.em_res_power, o.snr, o.proposal_id, o.n_obs, o.multi_ob, o.obs_release_date, o.access_url, o.access_estsize, f.archive_id, f.eso_category, p.source_file
FROM ivoa.ObsCore AS o
LEFT OUTER JOIN phase3v2.product_files AS f ON o.dp_id=f.product_id AND f.archive_id=f.product_id
LEFT OUTER JOIN phase3v2.provenance AS p ON f.internal_file_id=p.product_file
