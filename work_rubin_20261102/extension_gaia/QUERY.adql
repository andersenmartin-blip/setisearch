SELECT TOP 50000 source_id,ra,dec,ref_epoch,ra_error,dec_error,pmra,pmdec,pmra_error,pmdec_error,pmra_pmdec_corr,parallax,parallax_error,parallax_over_error,radial_velocity,radial_velocity_error,ruwe,duplicated_source,astrometric_params_solved,phot_g_mean_mag,ra_pmra_corr,dec_pmdec_corr,ra_dec_corr FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',8.986275,-42.709834,1.1)) ORDER BY source_id
