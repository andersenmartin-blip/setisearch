XTENSION= 'BINTABLE'           / marks the beginning of a new HDU               BITPIX  =                    8 / array data type                                NAXIS   =                    2 / number of array dimensions                     NAXIS1  =                   12 / length of first array dimension                NAXIS2  =                63086 / length of second array dimension               PCOUNT  =                    0 / group parameter count (not used)               GCOUNT  =                    1 / group count (not used)                         TFIELDS =                    4 / number of table fields                         TTYPE1  = 'CADENCENO'          / column title: unique cadence number            TFORM1  = 'J       '           / column format: signed 32-bit integer           TDISP1  = 'I10     '           / column display format                          TTYPE2  = 'RAWX    '           / column title: CCD column                       TFORM2  = 'I       '           / column format: signed 16-bit integer           TUNIT2  = 'pixel   '           / column units: null                             TDISP2  = 'I4      '           / column display format                          TTYPE3  = 'RAWY    '           / column title: CCD row                          TFORM3  = 'I       '           / column format: signed 16-bit integer           TUNIT3  = 'pixel   '           / column units: null                             TDISP3  = 'I4      '           / column display format                          TTYPE4  = 'COSMIC_RAY'         / column title: cosmic ray correction            TFORM4  = 'E       '           / column format: 32-bit floating point           TUNIT4  = 'e-/s    '           / column units: electrons per second             TDISP4  = 'E14.7   '           / column display format                          INHERIT =                    T / inherit the primary header                     EXTNAME = 'TARGET COSMIC RAY'  / name of extension                              EXTVER  =                    1 / extension version number (not format version)  SIMDATA =                    F / file is based on simulated data                END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             